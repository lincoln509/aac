#!/bin/sh
# .githooks/pre-commit
#
# Relance scripts/build.py avant chaque commit : il régénère
# web-demo/generated/ (règles, corpus, instantanés hors-ligne) à partir de
# leurs sources uniques. Si un fichier généré change, il est ajouté au commit
# en cours -- vous n'avez plus jamais à y penser. Les pages web-demo/*.html
# ne sont jamais modifiées par ce hook.
#
# Installation (une seule fois par clone) :
#   git config core.hooksPath .githooks
#
# Pour désactiver temporairement (déconseillé) :
#   git config --unset core.hooksPath

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 introuvable, génération de web-demo/generated/ ignorée." >&2
    exit 0
fi

python3 scripts/build.py

if ! git diff --quiet -- web-demo/generated || [ -n "$(git ls-files --others --exclude-standard -- web-demo/generated)" ]; then
    git add web-demo/generated
    echo "pre-commit: web-demo/generated/ mis à jour et ajouté au commit."
fi

exit 0
